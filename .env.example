# Copy to .env.local and fill in. Never commit real keys.
# All Cala and LLM calls run server-side; none of these are exposed to the browser
# except the two NEXT_PUBLIC_SUPABASE_* values, which are public by design.

# When "true", lib/cala returns fixtures from lib/mocks and the app runs without any API.
# When "false", Market is live from Cala (other pages are still fixtures until Phase 3).
USE_MOCKS=true

# "off" hides the demo personas and every page still on fixtures (Home, Search, My startup, Portfolio,
# Deck check, Met, Alerts, Events, Me, sign-in), leaving only live Cala features. Restart after changing.
DEMO_DATA=on

# Cala knowledge graph (server only). Create one at https://console.cala.ai/api-keys
CALA_API_KEY=

# Supabase (auth + Postgres cache)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Django backend (../Backend-Junction-2026). Deck checks and the LLM steps of market analysis (guard and
# report summary) run there; its .env holds GEMINI_API_KEY. The frontend has no LLM key.
BACKEND_URL=http://localhost:8000
# Until real sign-in exists, the app talks to the backend as this demo account (created on first use).
BACKEND_DEMO_EMAIL=demo@warmline.example
BACKEND_DEMO_PASSWORD=
