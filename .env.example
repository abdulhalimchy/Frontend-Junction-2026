# Copy to .env.local and fill in. Never commit real keys.
# All Cala and LLM calls run server-side; none of these are exposed to the browser
# except the NEXT_PUBLIC_* values, which are public by design.

# When "true", lib/cala returns fixtures from lib/mocks and the app runs without any API.
# When "false", Market is live from Cala (other pages are still fixtures until Phase 3).
USE_MOCKS=true

# Cala knowledge graph: called only by the backend (CALA_API_KEY in Backend-Junction-2026/.env). The frontend
# reaches Cala through the backend's /api/v1/cala/ gateway with this shared secret. Same value as
# CALA_GATEWAY_KEY in the backend's .env. Generate one: openssl rand -base64 32
CALA_GATEWAY_KEY=

# Google sign-in (the only sign-in): OAuth web client ID from Google Cloud console > APIs & Services >
# Credentials. Add http://localhost:3000 (and the production URL) to its Authorized JavaScript origins.
# Same value as GOOGLE_CLIENT_ID in the backend's .env. Restart after changing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase (auth + Postgres cache)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Django backend (../Backend-Junction-2026). Deck checks and the LLM steps of market analysis (guard and
# report summary) run there; its .env holds GEMINI_API_KEY. The frontend has no LLM key.
# Requests run as the signed-in user (their backend JWTs are in httpOnly cookies).
BACKEND_URL=http://localhost:8000
